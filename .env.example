# ------------------------------------------------------------------
# LinkedIn Profile API — environment configuration (copy to .env)
# All values below are optional and have sensible defaults.
# NEVER commit .env or any real session/credential file.
# ------------------------------------------------------------------

# Server
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# LinkedIn Playwright session state (auth cookies). Generated by `pnpm linkedin:login`.
# Path is relative to the project root.
LINKEDIN_STATE_PATH=storage/linkedin-state.json

# Set to true to launch a headed browser (useful for local debugging / manual login).
# In production/containers keep this false (headless).
HEADLESS=true

# Browser
BROWSER_LAUNCH_TIMEOUT_MS=60000
PAGE_NAVIGATION_TIMEOUT_MS=45000
EXTRACTION_TIMEOUT_MS=60000
API_REQUEST_TIMEOUT_MS=90000

# Concurrency — max simultaneous profile extraction tasks
MAX_CONCURRENT_EXTRACTIONS=2

# Cache TTL (seconds). 0 disables caching.
CACHE_TTL_SECONDS=3600

# API rate limit — requests per window / window size
RATE_LIMIT_MAX=30
RATE_LIMIT_TIME_WINDOW=1 minute
